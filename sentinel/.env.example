# Required for LLM evaluation (not needed for --dry-run)
ANTHROPIC_API_KEY=sk-ant-...

# Configure at least one channel; if none is set, alerts print to stdout.
# Telegram: create a bot via @BotFather, message it once, get chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: channel settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=
