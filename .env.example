# rpbot environment variables. Copy to .env and replace placeholders.
#
# Related repositories (GitHub):
#   https://github.com/0prob/rust_polygon_arbitrage_bot     — this bot (routing, simulation, execution)
#   https://github.com/0prob/polygon_envio_hyperindex       — Envio HyperIndex discovery feed (PG_URL)
#   https://github.com/0prob/solidity_and_huff_evm_contract — Huff ArbExecutor (live submits)
#
# Load order: code defaults (src/config/mod.rs) → .env (or DOTENV_PATH).
# Process env already set is never overwritten by .env.
# Blank optional values are ignored. Never commit .env or private keys.
#
# Values below marked (example) are non-default tuning samples for dry-run.
# Uncommented KEY=value lines are what a typical .env starts with.

# DOTENV_PATH=.env

# ─── Database (pool discovery) ─────────────────────────────────────────────────

# PostgreSQL connection string (code default: postgres://postgres@localhost:5433/envio-dev)
PG_URL=postgres://postgres@localhost:5433/envio-dev

# ─── Live execution (required when EXECUTION_MODE=live) ────────────────────────

# Wallet private key (0x + 64 hex chars). Leave unset for dry-run — non-hex fails startup.
# PRIVATE_KEY=0x...
# Alternative: path to a file containing the raw private key
# PRIVATE_KEY_FILE=./path/to/keyfile

# Deployed ArbExecutor (Huff) contract address — required for EXECUTION_MODE=live.
# Deploy from https://github.com/0prob/solidity_and_huff_evm_contract :
#   git clone https://github.com/0prob/solidity_and_huff_evm_contract.git
#   cd solidity_and_huff_evm_contract && OWNER=<bot_wallet> PRIVATE_KEY=0x... ./script/deploy_mainnet.sh
# EXECUTOR_ADDRESS=0xYourExecutorAddress

# ─── RPC (HTTP) ────────────────────────────────────────────────────────────────
#
# Role guide (bot probes STATE + POLYGON_RPC_URLS and reorders fastest-first at startup):
#   EXECUTION_RPC     — HF dry-run eth_call, gas, balance, receipt polling only
#   STATE_RPC_URL     — primary multicall pool-state reads (+ failover list below)
#   POLYGON_RPC_URLS  — state-read failover; put paid/premium first, public/free last
#   PRIVATE_RPC_URL   — live tx submit only (never used for simulation)
#
# EXECUTION_RPC is excluded from state multicall so execution quota is not spent on refresh.
# Prefer not putting Alchemy in POLYGON_RPC_URLS if you use it for EXECUTION_RPC
# (aggregate3 burns CU × subcalls on Alchemy).

# Simulation / dry-run (premium endpoint recommended)
EXECUTION_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Alias when EXECUTION_RPC is absent:
# EXECUTION_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Primary state-read RPC (multicall pool refresh)
STATE_RPC_URL=https://lb.drpc.live/polygon/YOUR_KEY

# Comma-separated state failover — paid endpoints first, public/free last
POLYGON_RPC_URLS=https://polygon-mainnet.core.chainstack.com/YOUR_KEY,https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY,https://lb.drpc.live/polygon/YOUR_KEY,https://polygon-bor-rpc.publicnode.com,https://rpc.ankr.com/polygon/YOUR_KEY
# Single-endpoint alias when POLYGON_RPC_URLS is absent:
# POLYGON_RPC_URL=https://polygon-rpc.com

# MEV-protected submission (Polygon relay eth_sendRawTransactionPrivate, etc.)
# Not used for simulation. Do not set this to api.blxrbdn.com — use BLOXROUTE_AUTH_HEADER instead.
# PRIVATE_RPC_URL=https://your-polygon-private-relay.example

# ─── RPC (WebSocket stream) ────────────────────────────────────────────────────

# Filtered eth_subscribe pool log stream (code default: false).
# When true, set WSS_URL or POLYGON_WSS_URLS (http→wss fallback from STATE_RPC_URL is unreliable).
STREAM_ENABLED=false

# Max V2/V3 pools tracked by partial cache + WSS subscriptions (code default: 200)
# STREAM_MAX_POOLS=200

# Single WSS endpoint — overrides POLYGON_WSS_URLS when set
# WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Comma-separated WSS URLs — probed on reconnect, fastest healthy wins
# POLYGON_WSS_URLS=wss://lb.drpc.live/polygon/YOUR_KEY,wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Single WSS alias when POLYGON_WSS_URLS is absent:
# POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ─── HyperSync (Envio) ───────────────────────────────────────────────────────

# API token — enables HyperSync head feed and receipt lookups (optional)
# ENVIO_API_TOKEN=your_envio_token

# Override HyperSync base URL (optional)
# HYPER_SYNC_URL=https://polygon.hypersync.xyz

# ─── Execution ───────────────────────────────────────────────────────────────

# dry-run | live | dry_run | dryrun (code default: dry-run)
EXECUTION_MODE=dry-run

# Deprecated: execution enforces a $0.01 final-profit floor from POL/USD.
MIN_PROFIT_MATIC_WEI=0

# Optional extra static slippage allowance in basis points (code default: 0).
# Dynamic depth impact is always included; this only widens execution limits.
# SLIPPAGE_BPS=0

# Flash loan policy (code default: auto).
# Accepted: auto | balancer | balancer_only | aave | aave_v3
#   auto          — per-cycle: Balancer vault flash when safe; pure Balancer → executeArbDirect;
#                   mixed Balancer hops → Aave V3; size capped to live liquidity (cap-and-reoptimize)
#   balancer(_only) — Balancer vault flash / Direct only (rejects when Aave would be required)
#   aave / aave_v3  — Aave V3 flashLoanSimple only (Polygon Pool 0x794a61358D6845594F94dc1DB02A252b5b4814aD)
# DODO flash is not selectable via env — const DODO_EXTERNAL_FLASH_ENABLED=false in profit.rs.
# Fees are not env-configured: Aave premium and Balancer protocol flash fee are RPC-refreshed.
FLASH_LOAN_SOURCE=auto

# Receipt wait timeout / poll interval in ms (code defaults: 30000 / 200)
# RECEIPT_TIMEOUT_MS=30000
# RECEIPT_POLL_MS=200

# Maximum flash loan borrow size in USD notional (code default: 50000). Converted via MATIC/USD.
# MAX_FLASH_LOAN_USD=50000

# Transaction deadline in seconds (code default: 120)
# EXECUTION_DEADLINE_SECS=120

# Require all live submissions through PRIVATE_RPC_URL or bloXroute (code default: false)
# REQUIRE_PRIVATE_SUBMIT=false

# Submission priority uplift = profit * alpha / 10000 (code default: 1000 bps = 10%).
# Base fee and the RPC priority fee are assessed separately by the gas oracle.
# PROFIT_PRIORITY_FEE_ALPHA_BPS=1000

# Net profit must exceed worst-case gas × multiplier / 10000
# Code default: 10000 (1.0×). Live requires 10000..=100000; dry-run allows 0..=100000.
PROFIT_SAFETY_MULTIPLIER_BPS=10000

# Operator MATIC balance floor — pauses execution when breached (code default: 0.5 MATIC)
# MIN_OPERATOR_MATIC_WEI=500000000000000000

# Circuit breaker: max consecutive failures before global pause (code default: 8)
# MAX_GLOBAL_CONSECUTIVE_FAILURES=8

# Minimum net ROI in basis points of flash loan size (code default: 0 = disabled)
# MIN_PROFIT_ROI_BPS=0

# Auto-pause when cumulative daily loss exceeds threshold in MATIC wei (code default: empty = disabled)
# MAX_DAILY_LOSS_MATIC_WEI=0

# Learned route stats file path (code default: .rpbot-route-stats.json)
# ROUTE_STATS_PATH=.rpbot-route-stats.json

# ─── Private mempool (bloXroute) ───────────────────────────────────────────────

# bloXroute BDN auth header (portal Account Details) — submits via polygon_private_tx.
# Takes precedence over PRIVATE_RPC_URL. Nonce/chain-id still use EXECUTION_RPC.
# BLOXROUTE_AUTH_HEADER=your_bloxroute_auth_header

# ─── Routing ─────────────────────────────────────────────────────────────────

# Maximum hops in arbitrage cycle search (code default: 5, valid: 2–8 = HOP_CAP)
ROUTING_MAX_HOPS=5

# Golden-section / Brent size-search iterations (code default: 12).
# Alias: TERNARY_SEARCH_ITERATIONS (legacy module name).
# BRENT_SEARCH_ITERATIONS=12
# TERNARY_SEARCH_ITERATIONS=12

# Maximum cycle paths to enumerate per LF tick (code default: 13).
# Higher values increase LF CPU; config warns above 1000 (try ≤650 for tuned LF).
# Example: more enumeration budget for denser graphs
ROUTING_ENUMERATION_MAX_PATHS=13

# Cycle finder: hybrid (default) | dfs | johnson | bellman-ford
# (johnson is an alias for bellman-ford)
# ROUTING_CYCLE_FINDER=hybrid

# ─── Pipeline intervals ───────────────────────────────────────────────────────

# LF graph/cycle pass interval in ms (code default: 1000).
# Without STREAM_ENABLED, values <~2500 may backlog LF (warn_suboptimal).
LF_INTERVAL_MS=1000

# HF optimize/execute pass interval in ms (code default: 200)
# Very low values (<100) pile pending work behind the ~3.5s tick hard budget.
HF_INTERVAL_MS=200

# Pool discovery refresh interval in ms (code default: 5000)
# DISCOVERY_INTERVAL_MS=5000

# PoolMeta rows per paginated bootstrap query (code default: 20000)
# DISCOVERY_BOOTSTRAP_BATCH=20000

# Pool metadata cache file path (code default: .rpbot-pool-meta.json)
# POOL_META_CACHE_PATH=.rpbot-pool-meta.json

# ─── LF tuning ───────────────────────────────────────────────────────────────

# Pools fetched per bootstrap batch on first LF pass (code default: 3000)
# LF_BOOTSTRAP_BATCH=3000

# Pools fetched per LF hot refresh batch (code default: 500)
LF_HOT_BATCH=500

# Full pool sweep interval in LF ticks (code default: 10)
LF_FULL_SWEEP_INTERVAL=10

# Graph cycle refind interval in LF ticks (code default: 8)
CYCLE_REFIND_INTERVAL=8

# ─── HF tuning ───────────────────────────────────────────────────────────────

# Pools prefetched per HF tick (code default: 60; clamped to min(2×MAX_MULTICALL_CALLS, 200))
HF_PREFETCH_COUNT=60
# Shared prep wall (ms) for stream recovery + pool/flash + TickLens hydrate.
# Code default: 2500. Normalized floor 900 (one TickLens pool); cap 8000.
# Leave ≥900ms residual for hydrate after pool/flash work (work + hydrate).
HF_PREFETCH_BUDGET_MS=2500

# Max cycles rescored per HF tick (normalized to HF_SIM_CAP..2x HF_SIM_CAP; input cap 512)
HF_SCORE_CAP=120

# Max cycles simulated per HF tick (code default: 120; cap 512)
HF_SIM_CAP=120

# Max live dispatches per HF tick (code default: 8; clamped to HF_SIM_CAP)
HF_MAX_DISPATCH=8

# Graph connectivity rebuild interval in LF passes (code default: 60), not wall-clock seconds
# GRAPH_REBUILD_INTERVAL=60

# ─── Indexer health ──────────────────────────────────────────────────────────

# Pause execution when indexer lag exceeds threshold (code defaults: 200 blocks / true)
# INDEXER_MAX_LAG_BLOCKS=200
# INDEXER_PAUSE_ON_LAG=true

# Optional Balancer metadata bootstrap (RPC remains state source of truth)
# BALANCER_BACKEND_URL=https://api-v3.balancer.fi/

# ─── Oracle ──────────────────────────────────────────────────────────────────

# Pyth Hermes HTTP endpoint (code default: https://hermes.pyth.network)
# ORACLE_PYTH_HERMES_URL=https://hermes.pyth.network

# V3 TickLens: tick words fetched on each side of current tick (code default: 6; clamped 1–48)
# Probe path already uses min(4); higher values cost multicall budget on LF.
# TICK_WORD_RANGE=6

# Oracle USD price cache TTL in ms (code default: 10000)
# ORACLE_CACHE_TTL_MS=10000

# Hub-path token→WMATIC rates for profit scoring (code defaults: enabled, max 4 hops)
# ORACLE_HUB_PATH_RATES=true
# ORACLE_HUB_PATH_MAX_HOPS=4

# Comma-separated token=feed mappings (optional overlays on hard-coded TOKEN_FEEDS)
# ORACLE_PYTH_FEEDS=0xToken=feed_id_hex,...
# ORACLE_CHAINLINK_FEEDS=0xToken=0xFeed,...

# ─── RPC tuning ──────────────────────────────────────────────────────────────

# Max calls per multicall batch (code default: 200)
MAX_MULTICALL_CALLS=200

# Sleep between pool-fetch multicall batch pairs in ms (code default: 5)
RPC_BATCH_PACE_MS=5

# Per-request HTTP timeout in ms (code default: 12000; clamped 1000–60000).
# Alias: REQUEST_TIMEOUT_MS. Prefer fail-fast + multi-URL failover over 30s hangs.
RPC_REQUEST_TIMEOUT_MS=12000

# ─── Logging & runtime ───────────────────────────────────────────────────────

# Log filter: error | warn | info | debug | trace (code default: info)
# RPBOT_LOG=info
# Component JSONL directory (code default: /tmp/bot)
# RPBOT_LOG_DIR=/tmp/bot
# Allow concurrent rpbot/tui processes (skips startup peer kill). Unset = kill others.
# RPBOT_ALLOW_MULTIPLE=1

# Rayon worker thread count (stdlib; optional)
# RAYON_NUM_THREADS=8

# ─── Protocol toggles ───────────────────────────────────────────────────────
#
# QuickSwap V2, Uniswap V2, and SushiSwap V2 are included when unset (enabled).
# Set to exactly "true" to keep enabled; any other value (e.g. "false") disables them.
# QUICKSWAP_V2_ENABLED=false
# UNISWAP_V2_ENABLED=false
# SUSHISWAP_V2_ENABLED=false

# ─── Oracle auto-feeds (in-bot Hermes scan) ────────────────────────────────
# Persisted discovered Pyth USD feeds + no_feed marks.
# RPBOT_ORACLE_AUTO_FEEDS=target/run-logs/oracle-auto-feeds.json
# Optional demand snapshot (written on throttled LF unmapped logs)
# RPBOT_ORACLE_DEMAND_SNAPSHOT=target/run-logs/oracle-demand.json

# Full env → config key map: src/config/mod.rs (`env_key_to_figment_path` + apply_conditional_env_overrides).
