# rpbot environment variables. Copy to .env and replace placeholders.
#
# Three-repo layout (sibling directories under /home/x/arb/):
#   h/   — Envio HyperIndex discovery feed (PG_URL targets its postgres)
#   c/   — this bot (rpbot): routing, simulation, execution orchestration
#   sol/ — Huff ArbExecutor contract deployed for live submits
# load order: defaults → config.toml (CONFIG_PATH or ./config.toml) → env
# DOTENV_PATH selects an alternate env file. Existing process env is not overwritten.
# Blank optional values are ignored. Never commit .env or private keys.

# DOTENV_PATH=.env
# CONFIG_PATH=config.toml

# ─── Database (pool discovery) ─────────────────────────────────────────────────

# PostgreSQL connection string (default: postgres://postgres@localhost:5433/envio-dev)
PG_URL=postgres://postgres@localhost:5433/envio-dev

# ─── Live execution (required when EXECUTION_MODE=live) ────────────────────────

# Wallet private key (0x + 64 hex chars)
PRIVATE_KEY=your_private_key
# Alternative: path to a file containing the raw private key
# PRIVATE_KEY_FILE=./path/to/keyfile

# Deployed ArbExecutor contract address
EXECUTOR_ADDRESS=0xYourExecutorAddress

# ─── RPC (HTTP) ────────────────────────────────────────────────────────────────
#
# Role guide (bot probes and reorders STATE + POLYGON_RPC_URLS fastest-first at startup):
#   EXECUTION_RPC     — HF dry-run eth_call, gas, balance, receipt polling only
#   STATE_RPC_URL     — primary multicall pool-state reads (+ failover list below)
#   POLYGON_RPC_URLS  — state-read failover; put paid/premium first, public/free last
#   PRIVATE_RPC_URL   — live tx submit only (never used for simulation)
#
# Provider notes:
#   Alchemy     — best for EXECUTION_RPC (eth_call, gzip, trace/simulate on paid tier)
#   dRPC        — good load-balanced STATE + fastest WSS in most regions
#   Chainstack  — solid WSS logs; HTTP RPS plan-limited (25–600 RPS by tier)
#   Ankr        — usable fallback; often higher latency under load
#   PublicNode  — free public fallback only; no SLA, intermittent 403s

# Simulation / dry-run (premium endpoint recommended)
EXECUTION_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Alias when EXECUTION_RPC is absent:
# EXECUTION_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Primary state-read RPC (multicall pool refresh)
STATE_RPC_URL=https://lb.drpc.live/polygon/YOUR_KEY

# Comma-separated state failover — paid endpoints first, public/free last
POLYGON_RPC_URLS=https://polygon-mainnet.core.chainstack.com/YOUR_KEY,https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY,https://lb.drpc.live/polygon/YOUR_KEY,https://polygon-bor-rpc.publicnode.com,https://rpc.ankr.com/polygon/YOUR_KEY
# Single-endpoint alias when POLYGON_RPC_URLS is absent:
# POLYGON_RPC_URL=https://polygon-rpc.com

# MEV-protected submission (Polygon relay eth_sendRawTransactionPrivate, etc.)
# Not used for simulation. Do not set this to api.blxrbdn.com — use BLOXROUTE_AUTH_HEADER instead.
# PRIVATE_RPC_URL=https://your-polygon-private-relay.example

# ─── RPC (WebSocket stream) ────────────────────────────────────────────────────

# Enable filtered eth_subscribe pool log stream (recommended: true with POLYGON_WSS_URLS)
STREAM_ENABLED=true

# Max V2/V3 pools tracked by partial cache + WSS subscriptions (default: 500)
# STREAM_MAX_POOLS=500

# Single WSS endpoint — overrides POLYGON_WSS_URLS when set
# WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Comma-separated WSS URLs — probed on reconnect, fastest healthy wins (dRPC/Alchemy recommended)
# POLYGON_WSS_URLS=wss://lb.drpc.live/polygon/YOUR_KEY,wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY,wss://polygon-mainnet.core.chainstack.com/YOUR_KEY

# Single WSS alias when POLYGON_WSS_URLS is absent:
# POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Falls back to wss:// conversion from STATE_RPC_URL or first POLYGON_RPC_URLS when unset

# ─── HyperSync (Envio) ───────────────────────────────────────────────────────

# API token — enables HyperSync head feed and receipt lookups (optional)
# ENVIO_API_TOKEN=your_envio_token

# Override HyperSync base URL (optional)
# HYPER_SYNC_URL=https://polygon.hypersync.xyz

# ─── Execution ───────────────────────────────────────────────────────────────

# dry-run | live (default: dry-run)
EXECUTION_MODE=dry-run

# Minimum net profit in MATIC wei after flash-loan fees (default: 100000000000000000 = 0.1 MATIC)
# MIN_PROFIT_MATIC_WEI=100000000000000000

# Slippage tolerance in basis points (default: 50)
# SLIPPAGE_BPS=50

# Flash loan provider: auto (Balancer-first waterfall) | balancer | aave | aave_v3 (default: auto)
FLASH_LOAN_SOURCE=auto

# Receipt wait timeout / poll interval in ms (defaults: 30000 / 200)
# RECEIPT_TIMEOUT_MS=30000
# RECEIPT_POLL_MS=200

# Maximum flash loan borrow size in USD (default: 50000)
# MAX_FLASH_LOAN_USD=50000

# Transaction deadline in seconds (default: 120)
# EXECUTION_DEADLINE_SECS=120

# Require all live submissions through PRIVATE_RPC_URL (default: false)
# REQUIRE_PRIVATE_SUBMIT=false

# Priority fee = base fee + profit * alpha / 10000 (default: 1000 bps = 10%)
# PROFIT_PRIORITY_FEE_ALPHA_BPS=1000

# Net profit must exceed worst-case gas × multiplier / 10000 (default: 25000 = 2.5×)
PROFIT_SAFETY_MULTIPLIER_BPS=25000

# Operator MATIC balance floor — pauses execution when breached (default: 500000000000000000 = 0.5 MATIC)
# MIN_OPERATOR_MATIC_WEI=500000000000000000

# Circuit breaker: max consecutive failures before global pause (default: 8)
# MAX_GLOBAL_CONSECUTIVE_FAILURES=8

# Minimum net ROI in basis points of flash loan size (default: 0 = disabled)
# MIN_PROFIT_ROI_BPS=0

# Auto-pause when cumulative daily loss exceeds threshold in MATIC wei (default: 0 = disabled)
# MAX_DAILY_LOSS_MATIC_WEI=0

# Learned route stats file path (default: .rpbot-route-stats.json)
# ROUTE_STATS_PATH=.rpbot-route-stats.json

# ─── Private mempool (bloXroute) ───────────────────────────────────────────────

# bloXroute BDN auth header (from portal Account Details) — submits via polygon_private_tx.
# Takes precedence over PRIVATE_RPC_URL. Nonce/chain-id still use EXECUTION_RPC.
# BLOXROUTE_AUTH_HEADER=your_bloxroute_auth_header

# ─── Routing ─────────────────────────────────────────────────────────────────

# Maximum hops in arbitrage cycle search (default: 5, valid: 2-8)
# ROUTING_MAX_HOPS=6

# Ternary search iterations for input sizing (default: 12)
# TERNARY_SEARCH_ITERATIONS=12

# Maximum cycle paths to enumerate per LF tick (code default: 13; repo config.toml uses 500)
# ROUTING_ENUMERATION_MAX_PATHS=5000

# Cycle finder: hybrid (default) | dfs | johnson | bellman-ford
# ROUTING_CYCLE_FINDER=hybrid

# ─── Pipeline intervals ───────────────────────────────────────────────────────

# LF graph/cycle pass interval in ms (default: 1000)
# LF_INTERVAL_MS=1000

# HF optimize/execute pass interval in ms (default: 150)
# HF_INTERVAL_MS=150

# Pool discovery refresh interval in ms (default: 5000)
# DISCOVERY_INTERVAL_MS=5000

# PoolMeta rows per paginated bootstrap query (default: 5000)
# DISCOVERY_BOOTSTRAP_BATCH=5000

# Pool metadata cache file path (default: .rpbot-pool-meta.json)
# POOL_META_CACHE_PATH=/tmp/rpbot-pool-meta.json

# ─── LF tuning ───────────────────────────────────────────────────────────────

# Pools fetched per bootstrap batch on first LF pass (default: 3000)
# LF_BOOTSTRAP_BATCH=3000

# Pools fetched per LF hot refresh batch (default: 500)
# LF_HOT_BATCH=500

# Full pool sweep interval in LF ticks (default: 10)
# LF_FULL_SWEEP_INTERVAL=10

# ─── HF tuning ───────────────────────────────────────────────────────────────

# Pools prefetched per HF tick (default: 100)
# HF_PREFETCH_COUNT=100

# Max cycles rescored per HF tick (code default: 120; repo config.toml uses 400)
# HF_SCORE_CAP=150

# Max cycles simulated per HF tick (code default: 120; repo config.toml uses 300)
# HF_SIM_CAP=75

# Max live dispatches per HF tick (default: 8)
# HF_MAX_DISPATCH=8

# Graph rebuild interval in seconds (default: 60)
# GRAPH_REBUILD_INTERVAL=60

# ─── Indexer health ──────────────────────────────────────────────────────────

# Pause execution when indexer lag exceeds threshold (default: 200 blocks)
# INDEXER_MAX_LAG_BLOCKS=200
# INDEXER_PAUSE_ON_LAG=true

# Optional Balancer metadata bootstrap (RPC remains state source of truth)
# BALANCER_BACKEND_URL=https://api-v3.balancer.fi/

# ─── Oracle ──────────────────────────────────────────────────────────────────

# Pyth Hermes HTTP endpoint (default: https://hermes.pyth.network)
# ORACLE_PYTH_HERMES_URL=https://hermes.pyth.network

# V3 TickLens: tick words fetched on each side of current tick (default: 10)
# TICK_WORD_RANGE=10

# ─── RPC tuning ──────────────────────────────────────────────────────────────

# Max calls per multicall batch (default: 200)
# MAX_MULTICALL_CALLS=200

# Sleep between pool-fetch multicall batch pairs in ms (default: 5)
# RPC_BATCH_PACE_MS=5

# ─── Logging & runtime ───────────────────────────────────────────────────────

# Tracing filter: error | warn | info | debug | trace (default: info)
# RPBOT_LOG=info

# Rayon worker thread count (stdlib; optional)
# RAYON_NUM_THREADS=8

# ─── Protocol toggles ───────────────────────────────────────────────────────
#
# QuickSwap V2 and Uniswap V2 pools are excluded unless the var is exactly "true".
# Set to true to include them in discovery, routing, and execution.
# QUICKSWAP_V2_ENABLED=true
# UNISWAP_V2_ENABLED=true

# ─── TOML overrides (config.toml / CONFIG_PATH) ─────────────────────────────
#
# This repo ships config.toml with tuned values (min profit, HF caps, enumeration_max_paths, etc.).
# TOML merges before env; env wins on conflict. See src/config/mod.rs for the full key map.
#
# [rpc]
# request_timeout_ms = 30000   # per-request HTTP timeout (REQUEST_TIMEOUT_MS or RPC_REQUEST_TIMEOUT_MS)
#
# [oracle]
# pyth_feeds = "0xToken=feed_id_hex,..."
# chainlink_feeds = "0xToken=0xFeed,..."
